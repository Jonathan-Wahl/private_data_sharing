# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt


.sourcemaps
.versions
coverage

# Ionic
mobile/.ionic
mobile/dist-electron
mobile/www
mobile/platforms
mobile/plugins

# Compiled output
dist
tmp
out-tsc
bazel-out

# Node
node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-project
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*


# Miscellaneous
mobile/.angular
mobile/.angular/cache
.sass-cache/
.nx
.nx/cache
/connect.lock
coverage
/libpeerconnection.log
testem.log
/typings

# Rails API
api/.bundle
api/config/master.key
api/db/*.sqlite3
api/db/*.sqlite3-*
api/log/*
api/storage/*
api/tmp/*
api/vendor/bundle
!api/log/.keep
!api/storage/.keep
!api/tmp/.keep
!api/tmp/pids/.keep

# System files
.DS_Store
Thumbs.db
