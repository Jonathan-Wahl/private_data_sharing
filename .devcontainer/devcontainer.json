{
  "name": "Secure Share Android Dev",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/peer_to_peer_downloader",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "runServices": ["android-emulator"],
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 4200, 15555, 16080],
  "portsAttributes": {
    "3000": {
      "label": "Rails API"
    },
    "4200": {
      "label": "Ionic Mobile"
    },
    "15555": {
      "label": "Android ADB"
    },
    "16080": {
      "label": "Android Emulator noVNC"
    }
  },
  "postCreateCommand": "/usr/local/share/secure-share/post-create.sh",
  "postStartCommand": "/usr/local/share/secure-share/wait-for-android.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "Dart-Code.flutter",
        "esbenp.prettier-vscode",
        "rebornix.Ruby",
        "shopify.ruby-lsp",
        "openai.chatgpt"
      ]
    }
  }
}
