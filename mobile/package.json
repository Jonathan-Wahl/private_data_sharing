{
  "name": "secure-share",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "main": "electron/main.cjs",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:pack": "npm run build && electron-builder --dir",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:ci": "vitest run",
    "lint": "ng lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "assets:generate": "capacitor-assets generate --ios --android --iconBackgroundColor '#0b1220' --iconBackgroundColorDark '#0b1220' --splashBackgroundColor '#0b1220' --splashBackgroundColorDark '#0b1220'",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"electron/**/*.cjs\" \"*.{js,json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"electron/**/*.cjs\" \"*.{js,json,md,ts}\""
  },
  "private": true,
  "build": {
    "appId": "app.secureshare.desktop",
    "productName": "Secure Share",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "www/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@angular/animations": "20.3.25",
    "@angular/common": "20.3.25",
    "@angular/compiler": "20.3.25",
    "@angular/core": "20.3.25",
    "@angular/forms": "20.3.25",
    "@angular/platform-browser": "20.3.25",
    "@angular/platform-browser-dynamic": "20.3.25",
    "@angular/router": "20.3.25",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@ionic/angular": "^8.0.0",
    "ionicons": "^7.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.28",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular/cli": "20.3.28",
    "@angular/compiler-cli": "20.3.25",
    "@angular/language-service": "20.3.25",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.4.1",
    "@ionic/angular-toolkit": "^12.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.16.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "jsdom": "^29.1.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "karma-jsdom-launcher": "^21.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.3",
    "typescript": "~5.9.0",
    "vitest": "^3.2.6"
  },
  "description": "Privacy-first Ionic and Capacitor app for encrypted peer-to-peer sharing."
}
